//****************** Main Program **********************************

if (part_to_print == "tile base"){
	//create base slab with cutouts
	if (draw_base) difference(){

		chamfered_cuboid(b_w,b_h,b_t,chamfer);
		
		for (i = [0:(num_rows-1)*row_offset]){
			if (i%row_offset==0){
				y = base_y0+gap3/2+c_+b_y+gap3*i+b_y*2*i;
				if (include_tile_slots=="yes"){
					for (j = [0:num_columns-1]){
						graphic = tile_piece_svgs[i/row_offset*num_columns+j];
						if (graphic != ""){
							x = base_x0+gap3/2+c_+b_x+gap3*j+b_x*2*j;
							translate([x, y, b_t/2 - tile_thickness/2 + 1])
							cube([tile_slot_width,tile_slot_height,tile_thickness+2],center=true);
						}
					}
				}
				if (include_earth_and_sky_lines=="yes"){
					spread = 2*earth_sky_half_span*sap;
					earth_y1 = y-(spread/2);
					sky_y1 = earth_y1+(spread);
					
					translate([0,earth_y1,b_t/2+fudge])
					rotate([0,90,0])
					translate([0,0,-b_w/2])
					linear_extrude(height=b_w)
					circle(d=sap*2,$fn=2);
				
					translate([0,sky_y1,b_t/2+fudge])
					rotate([0,90,0])
					translate([0,0,-b_w/2])
					linear_extrude(height=b_w)
					circle(d=sap,$fn=2);
					
					if(include_target_graphics=="yes" && include_tile_slots=="yes"){
						earth_y2 = sky_y1+tile_height-spread+inter_row_distance;
						sky_y2 = earth_y2+(spread);
						
						translate([0,earth_y2,b_t/2+fudge])
						rotate([0,90,0])
						translate([0,0,-b_w/2])
						linear_extrude(height=b_w)
						circle(d=sap*2,$fn=2);

					
						translate([0,sky_y2,b_t/2+fudge])
						rotate([0,90,0])
						translate([0,0,-b_w/2])
						linear_extrude(height=b_w)
						circle(d=sap,$fn=2);
					}
				}	
			}
		}
	}

	// add graphics in target rows
	if (draw_graphics && include_target_graphics == "yes"){
		color("SlateGrey")
		for (i = [0:(num_rows-1)*row_offset]){
			if (i%row_offset==0){
			
				for (j = [0:num_columns-1]){
					svg = tile_piece_svgs[i/row_offset*num_columns+j];
					mmpu = tile_piece_mm_per_unit[i/row_offset*num_columns+j];
					offy = tile_piece_offset_y[i/row_offset*num_columns+j];
					if (svg != ""){
						target_offset = (include_tile_slots=="yes") ? 1 : 0;
						y_offset = vertical_move[i/row_offset*num_columns+j];
						x_offset = horizonal_move[i/row_offset*num_columns+j];
						x = base_x0+gap3/2+c_+b_x+gap3*j+b_x*2*j;
						y = base_y0+c_+b_y+gap3/2+(gap3+b_y*2)*(i+target_offset);
						translate([x+x_offset, y+y_offset, b_t/2 - (6 - graphic_height)])
						scale([sap,sap,1])
						tile_piece_graphic(svg, mmpu, offy);
					}
				}
			}
		}
	}
}
else if (part_to_print == "tile"){
			
	difference(){
		union(){
			if (draw_base) difference(){
				chamfered_cuboid(tile_width-s_g,tile_height-s_g,tile_thickness,chamfer);
				
				if (include_earth_and_sky_lines=="yes"){
					spread = 2*earth_sky_half_span*sap;
					earth_y1 = -gap3/2+(gap3-spread)/2;
					sky_y1 = earth_y1+(spread);

					translate([0,earth_y1,tile_thickness/2+fudge])
					rotate([0,90,0])
					translate([0,0,-gap3/2])
					linear_extrude(height=gap3)
					circle(d=sap*2,$fn=2);
				
					translate([0,sky_y1,tile_thickness/2+fudge])
					rotate([0,90,0])
					translate([0,0,-gap3/2])
					linear_extrude(height=gap3)
					circle(d=sap,$fn=2);
				}
			}
			
			svg = tile_piece_svgs[tile_or_puzzle_piece_number-1];
			mmpu = tile_piece_mm_per_unit[tile_or_puzzle_piece_number-1];
			offy = tile_piece_offset_y[tile_or_puzzle_piece_number-1];
			
			if (draw_graphics && svg != ""){
				offset = vertical_move[tile_or_puzzle_piece_number-1];
				offset_x = horizonal_move[tile_or_puzzle_piece_number-1];
				color("SlateGrey")
				translate([offset_x, offset, tile_thickness/2 - (6 - graphic_height)])
				scale([sap,sap,1])
				tile_piece_graphic(svg, mmpu, offy);
			}
		}
		
		translate([0,0,-tile_thickness/2-3-fudge])
		cube([tile_width*2,tile_height*2,6],center=true);
			
		//RFID tag
		if(embed_tag[tile_or_puzzle_piece_number-1]=="yes"){
			add_RFID_slot();
		}
	}
}

else if (part_to_print == "puzzle base"){
	
	if (include_puzzle_piece_slots=="yes"){
		if (draw_base) difference(){
			union(){
				if(base_shape == "rectangular"){
					chamfered_cuboid(b_w,b_h,b_t,chamfer);
				}
				else{
					chamfered_disk(b_w,b_t,chamfer);
				}
			}
			for (i = [0:19]){
				graphic = tile_piece_svgs[i];
				if (graphic != ""){
					graphic_x = horizonal_move[i];
					graphic_y = vertical_move[i];
					graphic_scale = 100;
					piece_base_width = piece_width[i];
					piece_base_height = piece_height[i];
					slot_width = piece_base_width + s_g;
					slot_height = piece_base_height + s_g;
					if (include_tile_slots=="yes"){
						translate([graphic_x, graphic_y, tile_thickness/2+2.5+fudge])
						cube([slot_width,slot_height,tile_thickness+5],center=true);
					}
				}
			}
		}
		if (draw_graphics) add_decorations();
	}
	
	else{
	
		if (draw_base) if(base_shape == "rectangular"){
			chamfered_cuboid(b_w,b_h,b_t,chamfer);
		}
		else{
			chamfered_disk(b_w,b_t,chamfer);
		}
		
		if (draw_graphics) color("SlateGrey")
		for (i = [0:19]){
			svg = tile_piece_svgs[i];
			mmpu = tile_piece_mm_per_unit[i];
			// no guideline registration on a puzzle -- the graphic centers on its piece
			
			if (svg != ""){
				graphic_x = horizonal_move[i];
				graphic_y = vertical_move[i];
				graphic_scale = piece_scaling[i]/100;
			
				translate([graphic_x, graphic_y, b_t/2 - (6 - graphic_height)])
				scale([graphic_scale,graphic_scale,1])
				tile_piece_graphic(svg, mmpu);
			
			}
		}
		
		if (draw_graphics) add_decorations();
	}
	
}
else if (part_to_print == "puzzle piece"){
	
	svg = tile_piece_svgs[tile_or_puzzle_piece_number-1];
	mmpu = tile_piece_mm_per_unit[tile_or_puzzle_piece_number-1];
	// no guideline registration on a puzzle -- the graphic centers on its piece
	piece_base_width = piece_width[tile_or_puzzle_piece_number-1];
	piece_base_height = piece_height[tile_or_puzzle_piece_number-1];
	graphic_scale = piece_scaling[tile_or_puzzle_piece_number-1]/100;

	difference(){
		union(){
			
			if (draw_graphics && svg != ""){
				color("SlateGrey")
				translate([0, 0, tile_thickness/2 - (6 - graphic_height)])
				scale([graphic_scale,graphic_scale,1])
				tile_piece_graphic(svg, mmpu);
			}
				
			if (draw_base) chamfered_cuboid(piece_base_width, piece_base_height, tile_thickness,chamfer);
		}
		
		s_g = slot_gap;

		offset_x = horizonal_move[tile_or_puzzle_piece_number-1];
		offset_y = vertical_move[tile_or_puzzle_piece_number-1];

		for (i = [tile_or_puzzle_piece_number:19]){
			graphic = tile_piece_svgs[i];
			
			if (graphic != ""){
				graphic_x = horizonal_move[i] - offset_x;
				graphic_y = vertical_move[i] - offset_y;
				piece_base_width = piece_width[i];
				piece_base_height = piece_height[i];
				slot_width = piece_base_width + s_g;
				slot_height = piece_base_height + s_g;
				if (include_tile_slots=="yes"){
					translate([graphic_x, graphic_y, 0])
					cube([slot_width,slot_height,(tile_thickness + graphic_height) * 2 + 5],center=true);
				}
			}
		}

		translate([0,0,-tile_thickness/2-3-fudge])
		cube([piece_base_width*2,piece_base_height*2,6],center=true);
			
		//RFID tag
		if(embed_tag[tile_or_puzzle_piece_number-1]=="yes"){
			add_RFID_slot();
		}
	}
}





//********************************** Modules **************************************

module chamfered_cuboid (x, y, z, c){
	intersection(){	
		translate([0,0,-z/2])
		linear_extrude(height=z)
		offset(delta=c, chamfer=true)
		square([x-2*c,y-2*c],center=true);

		rotate([0,90,0])
		translate([0,0,-x/2])
		linear_extrude(height=x)
		offset(delta=c, chamfer=true)
		square([z-2*c,y-2*c],center=true);

		rotate([90,0,0])
		translate([0,0,-y/2])
		linear_extrude(height=y)
		offset(delta=c, chamfer=true)
		square([x-2*c,z-2*c],center=true);
	}
}

module chamfered_disk (dia, thick, c){
	r = dia/2;
	
	translate([0,0,-thick/2])
	rotate_extrude($fn=200)
	polygon( points=[[0,0],[r-c,0],[r,c],[r,thick-c],[r-c,thick],[0,thick]] );
}

module add_RFID_slot(){
	translate([0,0,-tile_thickness/2+1])
	cylinder(d=30,h=1);
}

module add_decorations(){

	color("SlateGrey")
	for (i = [0:4]){
		if (a[i] > 0){
			if (decoration_type[i]=="circle") {
				// a[i] = decoration height
				// b[i] = circle thickness
				// c[i] = circle inner diameter
				// d[i] = move vertically
				// e[i] = move horizontally
				
				translate([e[i]*sap,d[i]*sap,1])
				linear_extrude(height=tile_thickness/2+a[i])
				difference(){
					circle(d=c[i]*sap+b[i]*sap, $fn=200);
					circle(d=c[i]*sap, $fn=200);
				}
			}
			else if (decoration_type[i]=="line"){
				// a[i] = decoration height
				// b[i] = x1
				// c[i] = y1
				// d[i] = x2
				// e[i] = y2
				// f[i] = line thickness
				
				bad = (b[i]==c[i] && d[i]==e[i] && b[i]==e[i]);
				if (!bad){
					run = d[i]*sap - b[i]*sap;
					sign_run = sign(run);
					rise = e[i]*sap - c[i]*sap;
					sign_rise = sign(rise);
					adjust = (sign_rise>=0 && sign_run>=0) ? 0 : 
							  (sign_rise>=0 && sign_run<0) ? -180 :
							  (sign_rise<0 && sign_run>=0) ? 0 :
															 -180;
					slope = atan(rise/run) + adjust;
					length = sqrt(rise*rise + run*run);
					
					translate([b[i]*sap,c[i]*sap,tile_thickness/2+1])
					rotate([0,0,slope])
					linear_extrude(height=a[i])
					translate([0,-f[i]/2*sap,0])
					square([length,f[i]*sap]);
				}
			}
		}
	}
}